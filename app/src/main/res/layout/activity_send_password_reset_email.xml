<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.pinillos.auxilium.activity.SendPasswordResetEmailActivity"
    android:background="@color/colorPrimaryDark">

    <Button
        android:id="@+id/resetPasswordButton"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/resetEmail_editText"
        android:layout_alignRight="@+id/resetEmail_editText"
        android:layout_centerVertical="true"
        android:onClick="sendPasswordResetEmail"
        android:text="Restablecer contraseña"
        tools:layout_editor_absoluteX="86dp"
        tools:layout_editor_absoluteY="231dp"
        style="?android:textAppearanceSmall" />

    <EditText
        android:id="@+id/resetEmail_editText"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_above="@+id/resetPasswordButton"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="60dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="152dp"
        android:hint="Introduce tu correo electrónico"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:textAlignment="center"/>
</RelativeLayout>
