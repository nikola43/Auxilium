<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.pinillos.auxilium.Others.SendPasswordResetEmail">

    <TextView
        android:id="@+id/email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="63dp"
        android:text="Introduce tu correo electrónico"
        tools:layout_editor_absoluteX="97dp"
        tools:layout_editor_absoluteY="94dp" />

    <Button
        android:id="@+id/resetPasswordButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/resetEmail_editText"
        android:layout_alignRight="@+id/resetEmail_editText"
        android:layout_centerVertical="true"
        android:onClick="sendPasswordResetEmail"
        android:text="Restablecer contraseña"
        tools:layout_editor_absoluteX="86dp"
        tools:layout_editor_absoluteY="231dp" />

    <EditText
        android:id="@+id/resetEmail_editText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/resetPasswordButton"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="60dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="152dp" />
</RelativeLayout>
