<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.pinillos.auxilium.activity.SignUpNewUserActivity"
    android:background="@drawable/signup_wallpaper">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/last_name1_editText"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/dni_editText"
                android:layout_alignStart="@+id/dni_editText"
                android:layout_below="@+id/first_name_editText"
                android:ems="10"
                android:hint="Primer apellido"
                android:inputType="textPersonName"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"
                />

            <EditText
                android:id="@+id/first_name_editText"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/last_name1_editText"
                android:layout_alignParentTop="true"
                android:layout_alignStart="@+id/last_name1_editText"
                android:layout_marginTop="26dp"
                android:ems="10"
                android:hint="Nombre"
                android:inputType="textPersonName"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"/>

            <EditText
                android:id="@+id/email_editText"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/dni_editText"
                android:layout_alignStart="@+id/dni_editText"
                android:layout_below="@+id/dni_editText"
                android:ems="10"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"/>

            <EditText
                android:id="@+id/dni_editText"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/password2_editText"
                android:layout_alignStart="@+id/password2_editText"
                android:layout_below="@+id/last_name2_editText"
                android:ems="10"
                android:hint="DNI"
                android:inputType="textPersonName"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"/>

            <EditText
                android:id="@+id/last_name2_editText"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/last_name1_editText"
                android:layout_alignStart="@+id/last_name1_editText"
                android:layout_below="@+id/last_name1_editText"
                android:ems="10"
                android:hint="Segundo apellido"
                android:inputType="textPersonName"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"/>



            <EditText
                android:id="@+id/password1_editText"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/email_editText"
                android:layout_alignStart="@+id/email_editText"
                android:layout_below="@+id/email_editText"
                android:ems="10"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"/>

            <EditText
                android:id="@+id/password2_editText"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/password1_editText"
                android:layout_centerHorizontal="true"
                android:ems="10"
                android:hint="Repita contraseña"
                android:inputType="textPassword"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"/>

            <Button
                android:id="@+id/signUp_button"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/spinnerCategory"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="40dp"
                android:onClick="singUpNewUser"
                android:text="Registrarse"
                android:textCursorDrawable="@drawable/color_cursor"
                android:background="@drawable/round_button"
                android:textColor="@color/white"/>

            <Spinner
                android:id="@+id/spinnerGroup"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/password2_editText"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"/>

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/spinnerGroup"
                android:layout_alignStart="@+id/spinnerGroup"
                android:layout_below="@+id/spinnerGroup"
                android:layout_marginTop="18dp"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:textCursorDrawable="@drawable/color_cursor"
                android:backgroundTint="@color/white"/>
        </RelativeLayout>
    </ScrollView>
</android.support.constraint.ConstraintLayout>