<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/user_image"
        android:src="@mipmap/ic_fireman_round"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"

        android:layout_margin="1dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"/>

    <TextView
        android:id="@+id/user_category"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/user_image"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"

        android:text="Categoria"
        android:textColor="#000000"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/user_group"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/user_category"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"

        android:text="Grupo"
        android:textColor="#000000"
        android:textSize="20sp"/>

    <TextView
        android:id="@+id/user_fname"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/user_group"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"

        android:text="Nombre"
        android:textColor="#000000"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/user_lname"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/user_fname"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"

        android:text="Apellidos"
        android:textColor="#000000"
        android:textSize="20sp"/>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/user_lname"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="10dp"/>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line"
        android:layout_alignParentStart="true"
        android:layout_marginTop="5dp">

        <ImageButton
            android:id="@+id/add_user_to_incidence_fab"
            android:layout_width="50dip"
            android:layout_height="50dip"
            android:layout_alignParentStart="true"
            android:layout_marginStart="15dp"
            android:background="@color/transparent"
            android:contentDescription="f"
            android:src="@drawable/ic_add_user_to_incidence" />

        <ImageButton
            android:id="@+id/test2"
            android:layout_width="50dip"
            android:layout_height="50dip"
            android:layout_alignEnd="@+id/test3"
            android:layout_alignTop="@+id/test3"
            android:layout_marginEnd="75dp"


            android:background="@color/transparent"
            android:contentDescription="btn2"
            android:src="@drawable/ic_show_organization_chart" />

        <ImageButton
            android:id="@+id/test"
            android:layout_width="50dip"
            android:layout_height="50dip"

            android:layout_marginStart="20dp"
            android:layout_toEndOf="@+id/add_user_to_incidence_fab"

            android:background="@color/transparent"
            android:contentDescription="df"
            android:src="@drawable/ic_show_incidence_position" />

        <ImageButton
            android:id="@+id/test3"
            android:layout_width="50dip"
            android:layout_height="50dip"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"

            android:background="@color/transparent"
            android:contentDescription="btn3"
            android:src="@drawable/ic_chat_incidence" />
    </RelativeLayout>
</RelativeLayout>